{
  "name": "@ektro-mv/mcp",
  "version": "0.2.0",
  "mcpName": "io.github.horizonnowhere/ektro-mv",
  "description": "MCP server for creating delivery-ready music videos with EKTRO-MV.",
  "keywords": [
    "ektro",
    "music-video",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "comfyui",
    "remotion",
    "seedance",
    "ace-step"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/HorizonNowhere/EKTRO-MV#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HorizonNowhere/EKTRO-MV.git",
    "directory": "mcp/ektro-mv-mcp"
  },
  "bugs": {
    "url": "https://github.com/HorizonNowhere/EKTRO-MV/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "server.json",
    "README.md"
  ],
  "bin": {
    "ektro-mv-mcp": "./dist/bin.js",
    "ektro-mv-mcp-http": "./dist/http-bin.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@ektro-mv/cli": "workspace:*",
    "@ektro-mv/composite": "workspace:*",
    "@ektro-mv/core": "workspace:*",
    "@ektro-mv/providers": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "vitest": "^2.1.0"
  }
}
