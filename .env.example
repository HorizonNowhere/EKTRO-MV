# --- Brain (LLM) ---
ANTHROPIC_API_KEY=
# Optional override for Anthropic-compatible gateways
ANTHROPIC_BASE_URL=
EKTRO_BRAIN_MODEL=claude-sonnet-4-20250514

# --- Video (Seedance / Volcengine Ark) — used from Plan 2 ---
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# --- Music (ACE-Step via ComfyUI) — used from Plan 2 ---
COMFYUI_URL=http://127.0.0.1:8188

# --- Subtitle (local whisper.cpp) ---
EKTRO_WHISPER_INSTALL_DIR=
EKTRO_WHISPER_MODEL=base
# (HERMES_WHISPER_INSTALL_DIR / HERMES_WHISPER_MODEL are accepted as aliases for backward compat)
FFMPEG_PATH=ffmpeg

# --- Composite (Remotion) ---
FFPROBE_PATH=ffprobe
# MCP runs are isolated below this root. MCP outputDir values must remain relative to it.
EKTRO_MV_OUTPUT_ROOT=./ektro-out
# Optional Streamable HTTP MCP endpoint. The HTTP bin defaults to 127.0.0.1:3210.
EKTRO_MV_MCP_HOST=127.0.0.1
EKTRO_MV_MCP_PORT=3210
# A token is optional on loopback. Non-loopback binding requires both a token and
# a comma-separated allowlist such as "media-agent.internal,localhost".
EKTRO_MV_MCP_TOKEN=
EKTRO_MV_MCP_ALLOWED_HOSTS=
# Use an installed Chromium (Chrome/Edge) instead of letting Remotion download its own
# headless shell (useful behind a firewall/proxy). Point to the browser executable:
# REMOTION_BROWSER_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
REMOTION_BROWSER_EXECUTABLE=
