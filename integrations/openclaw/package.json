{
  "name": "@ektro-mv/openclaw",
  "version": "0.2.0",
  "description": "OpenClaw tools for EKTRO-MV music-video generation.",
  "keywords": ["openclaw", "ektro", "music-video", "ai-agent", "tool-plugin"],
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/HorizonNowhere/EKTRO-MV#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HorizonNowhere/EKTRO-MV.git",
    "directory": "integrations/openclaw"
  },
  "bugs": {
    "url": "https://github.com/HorizonNowhere/EKTRO-MV/issues"
  },
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "files": ["dist", "openclaw.plugin.json", "README.md", "LICENSE", "skills"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run plugin:build && openclaw plugins validate --entry ./dist/index.js"
  },
  "dependencies": {
    "@ektro-mv/mcp": "0.2.0",
    "typebox": "^1.3.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openclaw": "2026.7.1",
    "typescript": "5.6.3"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": "2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.7.1",
      "pluginSdkVersion": "2026.7.1"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
